# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="julve_aio",  # Must be unique
    name="Julve AIO",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="julve_aio_app",
    stack_size=4 * 1024,  # Increased for picopass emulation
    fap_category="Tools",
    # Optional values
    fap_version="0.10.0",
    fap_icon="images/julve_aio.png",  # 10x10 1-bit PNG
    fap_description="Quick Action remote control app",
    fap_author="@DonJulve",
    fap_weburl="https://github.com/DonJulve/AIO_Flipper_Zero",
    fap_icon_assets="images",  # Image assets to compile for this application
    sources=[
        "*.c*",
        "!venv",
        "!.venv",
    ],
    fap_private_libs=[
        Lib(
            name="loclass",
            cflags=["-O3"],
        ),
    ],
)
